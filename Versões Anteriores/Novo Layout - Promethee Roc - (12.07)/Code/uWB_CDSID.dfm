        Lines.Strings = (
          
            '"ROC and ratio elicitation for PROMETHEE Ranking with Monte Carl' +
            'o Sensitivity Analysis and Kendall Test via web", code SU-PXOMO-' +
            'WF1,  is a software to solve Multicriteria Decision problems bas' +
            'ed on PROMETHEE II method with ROC and ratio elicitation. It req' +
            'uires a non-compensatory racionality from the decision-maker.')
